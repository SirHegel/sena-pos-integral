<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Catálogo | POS Integral</title><link rel="stylesheet" href="/estilos.css"></head>
<body><header><a class="brand" href="/catalogo">POS <strong>Integral</strong></a><span class="pill">Datos de demostración</span></header><main>
<div class="eyebrow">GESTIÓN DE PRODUCTOS</div><div class="heading"><div><h1>Catálogo</h1><p>Consulta y organiza los productos del negocio.</p></div><a class="button" href="/catalogo?tenant=${tenant}&amp;modo=nuevo">+ Nuevo producto</a></div>
<c:if test="${not empty mensaje}"><div class="success" role="status"><c:out value="${mensaje}"/></div></c:if>
<form class="filters" method="get" action="/catalogo"><label>Negocio<select name="tenant"><option value="11111111-1111-4111-8111-111111111111" ${tenant == '11111111-1111-4111-8111-111111111111' ? 'selected' : ''}>Negocio A · demostración</option><option value="22222222-2222-4222-8222-222222222222" ${tenant == '22222222-2222-4222-8222-222222222222' ? 'selected' : ''}>Negocio B · demostración</option></select></label><label class="grow">Buscar<input type="search" name="q" maxlength="128" value="<c:out value='${q}'/>" placeholder="Nombre o código del producto"></label><button type="submit">Consultar</button></form>
<section class="panel"><div class="section-title"><h2>Productos del negocio</h2><span><c:out value="${productos.size()}"/> resultados</span></div><div class="scroll"><table><thead><tr><th>Código</th><th>Producto</th><th>Tipo</th><th>Precio</th><th>IVA</th><th>Acciones</th></tr></thead><tbody>
<c:forEach items="${productos}" var="p"><tr><td><c:out value="${p.codigo()}"/></td><td><strong><c:out value="${p.nombre()}"/></strong><small><c:out value="${p.unidad()}"/></small></td><td><span class="tag"><c:out value="${p.tipo()}"/></span></td><td>$ <c:out value="${p.precio().toPlainString()}"/></td><td><c:out value="${p.iva()}"/></td><td class="actions"><a href="/catalogo?tenant=${tenant}&amp;modo=editar&amp;id=${p.productoId()}">Editar</a><form method="post" action="/catalogo"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="tenant" value="${tenant}"><input type="hidden" name="id" value="${p.productoId()}"><input type="hidden" name="accion" value="eliminar"><button class="danger" type="submit">Eliminar</button></form></td></tr></c:forEach>
<c:if test="${empty productos}"><tr><td colspan="6" class="empty"><strong>Aún no hay productos para esta consulta</strong><br>Agrega un producto o cambia la búsqueda.</td></tr></c:if>
</tbody></table></div></section><p class="hint">El precio se registra en COP y el IVA como una proporción entre 0 y 1.</p></main><footer>POS Integral · Catálogo</footer></body></html>
