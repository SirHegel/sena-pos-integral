<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Producto | POS Integral</title><link rel="stylesheet" href="/estilos.css"></head><body><header><a class="brand" href="/catalogo">POS <strong>Integral</strong></a><span class="pill">Datos de demostración</span></header><main class="narrow"><a class="back" href="/catalogo?tenant=${tenant}">← Volver al catálogo</a><h1>${empty producto ? 'Nuevo producto' : 'Editar producto'}</h1><p>Completa los datos del catálogo. Todos los campos son obligatorios.</p>
<form class="panel product-form" method="post" action="/catalogo"><input type="hidden" name="tenant" value="${tenant}"><input type="hidden" name="csrf" value="${csrf}"><input type="hidden" name="accion" value="${empty producto ? 'crear' : 'actualizar'}"><input type="hidden" name="id" value="${producto.productoId()}">
<div class="form-grid"><label>Código<input name="codigo" maxlength="64" required value="<c:out value='${producto.codigo()}'/>"></label><label>Nombre<input name="nombre" maxlength="128" required value="<c:out value='${producto.nombre()}'/>"></label><label>Precio (COP)<input name="precio" type="number" min="0.01" max="999999999999.99" step="0.01" required value="<c:out value='${producto.precio()}'/>"></label><label>IVA (proporción)<input name="iva" type="number" min="0" max="1" step="0.0001" required value="${empty producto ? '0' : producto.iva()}"></label><label>Tipo<select name="tipo"><c:forEach items="${['VENDIBLE','INSUMO','PLATO']}" var="t"><option value="${t}" ${producto.tipo() == t ? 'selected' : ''}>${t}</option></c:forEach></select></label><label>Unidad<input name="unidad" maxlength="32" required value="<c:out value='${empty producto ? "unidad" : producto.unidad()}'/>"></label><label>Descuento de inventario<select name="modoDescuento"><option value="DIRECTO" ${producto.modoDescuento() == 'DIRECTO' ? 'selected' : ''}>Directo</option><option value="RECETA" ${producto.modoDescuento() == 'RECETA' ? 'selected' : ''}>Por receta (sólo plato)</option></select></label></div><div class="form-actions"><a href="/catalogo?tenant=${tenant}">Cancelar</a><button type="submit">Guardar producto</button></div></form></main><footer>POS Integral · Catálogo</footer></body></html>
